# 复制为 .env 后按需修改（.env 已在 .gitignore 中，切勿把真实 Key 提交到 GitHub）

# ---------- 大模型 ----------
# openai = OpenAI 兼容接口（默认接 DeepSeek）；mock = 无密钥的规则兜底模型（用于演示与跑通链路）
LLM_MODE=openai
# DeepSeek 官方 OpenAI 兼容端点；[待核实] 以 https://api-docs.deepseek.com 为准
LLM_BASE_URL=https://api.deepseek.com/v1
# 两个名字都认：LLM_API_KEY 或 DEEPSEEK_API_KEY
LLM_API_KEY=sk-xxxxxx
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SEC=60

# ---------- 运行时预算（有界自主） ----------
MAX_STEPS=10
MAX_WALL_CLOCK_SEC=120
MAX_TOKEN_BUDGET=60000
TOOL_TIMEOUT_SEC=20

# ---------- 路径与沙箱 ----------
# 文件类工具只能在该目录内读写，越界一律拒绝
WORKSPACE_ROOT=./workspace
DATA_DIR=./.data

# ---------- 安全开关 ----------
# 危险工具（写文件 / 执行代码 / 删除待办）是否需要人工二次确认
REQUIRE_CONFIRM=true
# Python 代码片段执行：默认关闭。它并非安全沙箱，仅供教学演示
ALLOW_CODE_EXEC=false
# 是否允许 http_get_json 访问外部 URL
ALLOW_HTTP_FETCH=true

# ---------- 可观测性 ----------
LOG_LEVEL=INFO
